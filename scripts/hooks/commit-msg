#!/usr/bin/env python3
"""commit-msg hook: strip AI attribution lines from the commit message.

Removes only:
  - Co-authored-by trailers naming Claude or Copilot
  - the Claude Code footer line itself: "Generated with Claude Code" or
    "Generated with [Claude Code](<url>)", optionally after the robot emoji
Other lines that merely mention Claude Code are kept. Trailing blank lines
left behind are collapsed.
"""

import re
import sys

PATTERNS = (
    re.compile(r"(?i)^co-authored-by:.*(claude|copilot)"),
    re.compile(
        r"(?i)^\s*(?:\N{ROBOT FACE}\s*)?generated with "
        r"(?:claude code|\[claude code\]\([^)]*\))\s*$"
    ),
)


def clean(message: str) -> str:
    kept = [
        line
        for line in message.splitlines()
        if not any(p.search(line) for p in PATTERNS)
    ]
    while kept and not kept[-1].strip():
        kept.pop()
    return "\n".join(kept) + "\n"


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("usage: commit-msg <message-file>", file=sys.stderr)
        return 1
    path = argv[1]
    with open(path, encoding="utf-8") as fh:
        original = fh.read()
    cleaned = clean(original)
    if cleaned != original:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(cleaned)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
